---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import Music from '../components/Music.astro';
import Projects from '../components/Projects.astro';
import TechStrip from '../components/TechStrip.astro';
import { profile } from '../data/portfolio';
---

<Base
  title={profile.name.toUpperCase()}
  description={`${profile.name} is a ${profile.role.toLowerCase()} building full-stack web and mobile applications, and a performing musician.`}
>
  <main
    class="relative isolate mx-auto max-w-[1240px] overflow-hidden rounded-[28px] bg-surface shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9),0_0_0_1px_rgba(255,255,255,0.05)] md:rounded-[44px]"
  >
    <Hero />
    <TechStrip />
    <Experience />
    <Projects />
    <Education />
    <Music />
    <Contact />
  </main>
</Base>
