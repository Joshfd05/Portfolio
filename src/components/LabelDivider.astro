---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['relative flex items-center justify-center', className]} aria-hidden="true">
  <span class="absolute inset-x-0 top-1/2 h-px bg-line"></span>
  <span class="pill relative -rotate-3 cursor-default px-5 text-[0.7rem]">{label}</span>
</div>
