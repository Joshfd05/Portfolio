---
import { projects, sections } from '../data/portfolio';
import Icon from './Icon.astro';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';
---

<Panel id="work" tone="panel" layer={4}>
  <div class="px-6 py-20 md:px-12 md:py-28">
    <SectionHeading {...sections.projects} />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <li
            class="card flex flex-col rounded-[28px] p-6 transition duration-300 hover:-translate-y-1 hover:shadow-[0_22px_44px_-20px_rgba(0,0,0,0.8),inset_0_0_0_1px_rgba(220,185,138,0.25)] md:p-7"
            data-reveal
          >
            <div class="flex items-center justify-between gap-3 text-xs text-muted">
              <span>
                <span class="tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="mx-1.5 text-line" aria-hidden="true">/</span>
                {project.type}
              </span>
              {project.live && (
                <span class="flex items-center gap-1.5 text-accent">
                  <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                  Live
                </span>
              )}
            </div>

            <h3 class="mt-10 text-xl font-medium tracking-tight">{project.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{project.summary}</p>

            <ul class="mt-6 flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>

            <div class="mt-6 flex gap-5 border-t border-line pt-5 text-sm">
              {project.code && (
                <a
                  href={project.code}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-medium transition hover:text-accent"
                >
                  Code <Icon name="arrow-up-right" class="size-3.5" />
                  <span class="sr-only">for {project.title}</span>
                </a>
              )}
              {project.live && (
                <a
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-medium transition hover:text-accent"
                >
                  Live site <Icon name="arrow-up-right" class="size-3.5" />
                  <span class="sr-only">for {project.title}</span>
                </a>
              )}
              {!project.code && !project.live && project.note && <span class="text-muted">{project.note}</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Panel>
