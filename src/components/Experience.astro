---
import { experience, sections } from '../data/portfolio';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';
---

<Panel id="experience" tone="panel" layer={5}>
  <div class="px-6 py-20 md:px-12 md:py-28">
    <SectionHeading {...sections.experience} />

    <ol class="mx-auto mt-14 max-w-4xl space-y-4">
      {
        experience.map((job) => (
          <li
            class="card grid gap-6 rounded-[28px] p-6 md:grid-cols-[220px_1fr] md:p-9"
            data-reveal
          >
            <div>
              <p class="text-sm font-medium">{job.company}</p>
              <p class="mt-1 text-xs text-muted">{job.period}</p>
              {job.location && <p class="mt-0.5 text-xs text-muted">{job.location}</p>}
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-lg font-medium tracking-tight">{job.role}</h3>
                {job.placeholder && (
                  <span class="rounded-full bg-accent/10 px-3 py-1 text-[11px] text-accent">Details coming soon</span>
                )}
              </div>
              <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-ink-soft">
                {job.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              {job.stack && (
                <ul class="mt-6 flex flex-wrap gap-1.5">
                  {job.stack.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Panel>
