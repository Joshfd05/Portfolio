---
import { Image } from 'astro:assets';
import { experience, sections } from '../data/portfolio';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';
---

<Panel id="experience" tone="panel" layer={5}>
  <div class="px-6 py-20 md:px-12 md:py-28">
    <SectionHeading {...sections.experience} />

    <ol class="mx-auto mt-14 max-w-4xl space-y-4">
      {
        experience.map((job) => (
          <li
            class="card grid gap-6 rounded-[28px] p-6 md:grid-cols-[220px_1fr] md:p-9"
            data-reveal
          >
            <div>
              {job.logo && (
                <div class="mb-4 inline-flex h-14 items-center rounded-2xl bg-white px-4">
                  <Image src={job.logo} alt="" height={56} class="h-7 w-auto" />
                </div>
              )}
              <p class="font-medium">{job.company}</p>
              <p class="mt-1 text-xs text-muted">{job.period}</p>
              {job.location && <p class="mt-0.5 text-xs text-muted">{job.location}</p>}
            </div>
            <div>
              <h3 class="text-lg font-medium tracking-tight">{job.role}</h3>
              {job.summary && <p class="mt-2 text-sm leading-relaxed text-muted">{job.summary}</p>}
              <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-ink-soft">
                {job.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              {job.stack && (
                <ul class="mt-6 flex flex-wrap gap-1.5">
                  {job.stack.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Panel>
