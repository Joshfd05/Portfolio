---
import { socials } from '../data/portfolio';

interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}

const { size = 'sm', class: className } = Astro.props;
---

<ul
  class:list={[
    'flex items-center text-ink-soft',
    size === 'lg' ? 'gap-3 text-sm font-medium md:text-base' : 'gap-2 text-xs',
    className,
  ]}
>
  {
    socials.map((social, i) => (
      <li class:list={['flex items-center', size === 'lg' ? 'gap-3' : 'gap-2']}>
        {i > 0 && <span class="text-muted" aria-hidden="true">/</span>}
        <a href={social.href} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent">
          {social.label}
        </a>
      </li>
    ))
  }
</ul>
