---
import { Image } from 'astro:assets';
import { music, sections } from '../data/portfolio';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';
---

<Panel id="music" tone="panel" layer={2}>
  <div class="px-6 py-20 md:px-12 md:py-28">
    <SectionHeading {...sections.music} />

    <div class="mx-auto mt-14 grid max-w-6xl gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:gap-8">
      <div class="relative" data-reveal>
        <ul
          class="grid grid-flow-dense auto-rows-[120px] grid-cols-2 gap-2 sm:auto-rows-[150px] sm:grid-cols-4 lg:absolute lg:inset-0 lg:grid-rows-3"
        >
          {
            music.gallery.map((photo) => (
              <li
                class:list={[
                  'group relative overflow-hidden rounded-2xl bg-card',
                  photo.size === 'tall' && 'row-span-2',
                  photo.size === 'wide' && 'col-span-2',
                ]}
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[400, 800]}
                  sizes={photo.size === 'wide' ? '(min-width: 640px) 33vw, 100vw' : '(min-width: 640px) 17vw, 50vw'}
                  class="size-full object-cover transition duration-500 group-hover:scale-105"
                />
              </li>
            ))
          }
        </ul>
      </div>

      <ol class="space-y-3">
        {
          music.items.map((item) => (
            <li
              class:list={[
                'card rounded-3xl p-6',
                item.current && 'shadow-[0_1px_2px_rgba(0,0,0,0.35),inset_0_0_0_1px_rgba(220,185,138,0.3)]',
              ]}
              data-reveal
            >
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                <h3 class="font-medium tracking-tight">{item.title}</h3>
                <span
                  class:list={[
                    'inline-flex items-center gap-1.5 text-xs tabular-nums',
                    item.current ? 'text-accent' : 'text-muted',
                  ]}
                >
                  {item.current && (
                    <span class="relative flex size-1.5" aria-hidden="true">
                      <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-50 motion-reduce:animate-none" />
                      <span class="relative inline-flex size-1.5 rounded-full bg-accent" />
                    </span>
                  )}
                  {item.period}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Panel>
