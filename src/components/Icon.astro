---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 1.5 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icons[name]}
/>
