---
import { Image } from 'astro:assets';
import { hero, profile } from '../data/portfolio';
import Icon from './Icon.astro';
import Panel from './Panel.astro';
import SocialLinks from './SocialLinks.astro';
---

<Panel id="top" layer={7} class="overflow-hidden bg-[#394247]">
  <div class="relative min-h-[36rem] sm:min-h-[40rem] md:min-h-[44rem]">
    <div
      class="pointer-events-none absolute inset-0 md:inset-y-[-6%] md:right-[-8%] md:left-[32%] md:[mask-image:linear-gradient(to_right,transparent,black_22%)]"
    >
      <Image
        src={profile.headshot}
        alt={`Portrait of ${profile.name}`}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 768px) 74vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[center_18%] md:object-[20%_center]"
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1a2226] via-[#1a2226]/75 via-[20%] to-transparent to-[52%] md:bg-gradient-to-r md:from-[#394247] md:via-[#394247]/70 md:via-[18%] md:to-transparent md:to-[40%]"
      aria-hidden="true"
    ></div>

    <div class="relative flex min-h-[36rem] flex-col sm:min-h-[40rem] md:min-h-[44rem]">
      <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 px-5 pt-5 md:px-10 md:pt-7">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
          <a
            href={`mailto:${profile.email}`}
            class="inline-flex items-center gap-2 text-sm font-medium text-white transition hover:text-white/75 md:text-base"
          >
            <Icon name="mail" class="size-4 md:size-5" />
            {profile.email}
          </a>
          <a
            href={profile.cvUrl}
            download
            class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-medium text-[#1a1a1a] transition hover:bg-white/85 md:px-5"
          >
            <Icon name="download" class="size-4" />
            Download CV
          </a>
        </div>
        <SocialLinks size="lg" tone="light" />
      </header>

      <div
        class="grid flex-1 content-end gap-6 px-5 pt-10 pb-24 sm:px-8 md:px-12 md:pb-28 lg:content-center lg:grid-cols-2 lg:items-center"
      >
        <h1
          class="max-w-[11ch] text-[clamp(3.25rem,6.6vw,5.75rem)] leading-[0.84] font-semibold tracking-[-0.04em] text-white uppercase"
          data-reveal
        >
          {hero.nameLines.map((line) => <span class="block">{line}</span>)}
        </h1>
        <p
          class="max-w-[16rem] text-xl leading-snug font-medium text-white lg:ml-auto lg:max-w-[14rem] lg:text-[1.7rem] lg:leading-[1.2]"
          data-reveal
        >
          {hero.tagline}
        </p>
      </div>
    </div>
  </div>
</Panel>
