---
import { Image } from 'astro:assets';
import { hero, profile } from '../data/portfolio';
import Icon from './Icon.astro';
import Panel from './Panel.astro';
import SocialLinks from './SocialLinks.astro';
import TwoTone from './TwoTone.astro';
---

<Panel id="top" layer={8} class="hero-glow">
  <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 px-5 pt-5 md:px-8 md:pt-7">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center gap-2 text-sm font-medium text-ink-soft transition hover:text-accent md:text-base"
      >
        <Icon name="mail" class="size-4 md:size-5" />
        {profile.email}
      </a>
      <a href={profile.cvUrl} download class="pill px-5 py-2 text-sm md:px-6 md:py-2.5">
        <Icon name="download" class="size-4" />
        Download CV
      </a>
    </div>
    <SocialLinks size="lg" />
  </header>

  <div class="flex flex-col items-center px-5 pt-16 pb-24 text-center md:pt-24 md:pb-32">
    <div class="relative" data-reveal>
      <Image
        src={profile.headshot}
        alt={`Portrait of ${profile.name}`}
        width={416}
        height={416}
        loading="eager"
        class="size-36 rounded-full object-cover shadow-[0_24px_60px_-24px_rgba(220,185,138,0.45)] ring-[5px] ring-accent/30 sm:size-44 md:size-52"
      />
      <span
        class="pill absolute -bottom-4 left-1/2 -translate-x-1/2 -rotate-3 px-5 py-2 text-sm whitespace-nowrap md:top-6 md:bottom-auto md:left-[84%] md:translate-x-0 md:rotate-[8deg] md:px-6 md:py-2.5 md:text-base"
      >
        {hero.nameTag}
      </span>
    </div>

    <h1
      class="mt-12 max-w-3xl text-[2.6rem] leading-[1.05] font-medium tracking-tight text-balance sm:text-5xl md:text-[4rem]"
      data-reveal
    >
      <TwoTone segments={hero.headline} />
    </h1>

    <p class="mt-6 max-w-md text-sm leading-relaxed text-muted md:text-base" data-reveal>{hero.intro}</p>

    <a href={hero.cta.href} class="pill-primary mt-9" data-reveal>
      {hero.cta.label}
      <Icon name="arrow-up-right" class="size-4" />
    </a>
  </div>
</Panel>
