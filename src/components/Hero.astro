---
import { Image } from 'astro:assets';
import { hero, profile } from '../data/portfolio';
import Icon from './Icon.astro';
import Panel from './Panel.astro';
import SocialLinks from './SocialLinks.astro';
import TwoTone from './TwoTone.astro';
---

<Panel id="top" layer={8} class="hero-glow">
  <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 pt-5 md:px-8 md:pt-7">
    <div class="flex items-center gap-2">
      <a href={`mailto:${profile.email}`} class="mr-1 text-xs text-ink-soft transition hover:text-ink">
        {profile.email}
      </a>
      <button type="button" class="pill cursor-pointer" data-copy={profile.email} aria-label="Copy email address">
        <Icon name="copy" class="size-3.5" />
        <span data-copy-label>Copy</span>
      </button>
      {
        profile.cvUrl && (
          <a href={profile.cvUrl} class="pill" target="_blank" rel="noopener">
            <Icon name="file" class="size-3.5" />
            CV
          </a>
        )
      }
    </div>
    <SocialLinks />
  </header>

  <div class="flex flex-col items-center px-5 pt-16 pb-24 text-center md:pt-24 md:pb-32">
    <div class="relative" data-reveal>
      <Image
        src={profile.headshot}
        alt={`Portrait of ${profile.name}`}
        width={208}
        height={208}
        loading="eager"
        class="size-24 rounded-full object-cover ring-4 ring-accent/30 md:size-26"
      />
      <span class="pill absolute top-2 left-[78%] rotate-[8deg] whitespace-nowrap">{hero.nameTag}</span>
    </div>

    <h1
      class="mt-8 max-w-3xl text-[2.6rem] leading-[1.05] font-medium tracking-tight text-balance sm:text-5xl md:text-[4rem]"
      data-reveal
    >
      <TwoTone segments={hero.headline} />
    </h1>

    <p class="mt-6 max-w-md text-sm leading-relaxed text-muted md:text-base" data-reveal>{hero.intro}</p>

    <a href={hero.cta.href} class="pill-primary mt-9" data-reveal>
      {hero.cta.label}
      <Icon name="arrow-up-right" class="size-4" />
    </a>
  </div>
</Panel>
