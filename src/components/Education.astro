---
import { Image } from 'astro:assets';
import { education, sections } from '../data/portfolio';
import Panel from './Panel.astro';
import SectionHeading from './SectionHeading.astro';
---

<Panel id="education" tone="panel" layer={3}>
  <div class="px-6 py-20 md:px-12 md:py-28">
    <SectionHeading {...sections.education} />

    <ol
      class="card mx-auto mt-14 max-w-4xl divide-y divide-line rounded-[28px] px-6 md:px-9"
    >
      {
        education.map((entry) => (
          <li class="flex gap-5 py-7" data-reveal>
            <div
              class:list={[
                'grid size-14 shrink-0 place-items-center rounded-2xl',
                entry.logoOnDark ? 'bg-canvas ring-1 ring-line' : 'bg-white',
              ]}
            >
              <Image src={entry.logo} alt="" width={96} class="size-10 object-contain" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-medium tracking-tight">{entry.institution}</h3>
                <span class="text-xs text-muted tabular-nums">{entry.period}</span>
              </div>
              <p class="mt-1 text-sm text-ink-soft">{entry.qualification}</p>
              {entry.detail && <p class="mt-2 text-sm leading-relaxed text-muted">{entry.detail}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Panel>
